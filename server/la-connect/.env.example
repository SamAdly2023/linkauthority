# Public URL where this relay is reachable (no trailing slash). The provider redirect URIs are BASE_URL/callback/<provider>
BASE_URL=https://www.linkauthority.live/connect
# Long random string used to sign OAuth state and encrypt temporary payloads
CONNECT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Meta app (Business type, Facebook Login for Business + Instagram API)
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration id (leave empty to request scopes directly)
META_CONFIG_ID=

# Pinterest app (Standard access for public use)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# LinkedIn app (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set to 1 only once the Community Management API product is approved (Company Page posting)
LINKEDIN_ORG_SCOPES=0
LINKEDIN_API_VERSION=202601

# Licensing: point to a JSON file of keys (see licenses.example.json). Leave unset = anyone can connect (dev/open mode).
LICENSES_FILE=./licenses.json

# Optional
# STORE_DIR=/home/user/la-connect-store     # where temporary payloads/usage are kept (default: OS temp dir)
# ALLOW_HTTP=1                              # allow http:// return URLs for local testing only
# MOUNT_PATH=/connect                       # standalone mode: path prefix
# PORT=3000
